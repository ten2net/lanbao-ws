# 揽宝智能投研交易平台环境变量配置
# 复制此文件为 .env 并填写实际值

# ============================================
# 数据源API密钥
# ============================================

# Tushare API Token (必需)
# 获取地址: https://tushare.pro/register
TUSHARE_TOKEN=your_tushare_token_here

# ============================================
# 数据库配置
# ============================================

# DuckDB数据库路径
DUCKDB_PATH=./data/lanbao.duckdb

# ============================================
# ROS2配置
# ============================================

# ROS2 Domain ID
ROS_DOMAIN_ID=0

# ROS2日志级别
ROS_LOG_LEVEL=INFO

# ============================================
# 日志配置
# ============================================

# 日志级别
LOG_LEVEL=INFO

# 日志文件路径
LOG_FILE=./logs/lanbao.log

# ============================================
# 回测配置
# ============================================

# 默认初始资金
DEFAULT_INITIAL_CAPITAL=100000

# 佣金率
COMMISSION_RATE=0.0003

# 滑点
SLIPPAGE=0.001

# ============================================
# 风险控制配置
# ============================================

# 最大仓位比例
MAX_POSITION_SIZE=0.2

# 最大回撤
MAX_DRAWDOWN=0.1

# 最大日亏损
MAX_DAILY_LOSS=0.05

# ============================================
# LLM API Keys（至少配置一个）
# ============================================

DEEPSEEK_API_KEY=your_deepseek_key_here
QWEN_API_KEY=your_qwen_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# ============================================
# 新闻数据源
# ============================================

NEWS_EASTMONEY_ENABLED=true

# ============================================
# 智能投研
# ============================================

AI_RESEARCH_ENABLED=true
AI_RESEARCH_DAILY_REPORT_ENABLED=true
